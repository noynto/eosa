{{#hasUpcomingSessions}}
<section class="px-5 md:px-8 py-10 md:py-12 border-t border-bg-border">
    <div class="flex items-baseline justify-between mb-6">
        <div class="flex items-baseline gap-3">
            <span class="font-serif text-xs text-muted">03</span>
            <h2 class="font-serif text-2xl font-normal">Prochains ateliers</h2>
            <span class="text-xs text-secondary ml-1">réservez votre place</span>
        </div>
        <a href="/workshops#prochains-ateliers" class="text-xs text-secondary hover:text-primary transition-colors">Tout voir →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {{#upcomingSessions}}
        <div hx-get="/workshops/sessions/{{id}}/card" hx-trigger="load" hx-swap="outerHTML">
            <div class="border border-bg-border rounded-2xl overflow-hidden animate-pulse">
                <div class="aspect-[4/3] bg-bg-soft"></div>
                <div class="p-5 flex flex-col gap-2">
                    <div class="h-2 bg-bg-border rounded w-24"></div>
                    <div class="h-5 bg-bg-border rounded w-40"></div>
                    <div class="h-3 bg-bg-border rounded w-32 mt-2"></div>
                    <div class="h-3 bg-bg-border rounded w-24"></div>
                </div>
            </div>
        </div>
        {{/upcomingSessions}}
    </div>
</section>
{{/hasUpcomingSessions}}
