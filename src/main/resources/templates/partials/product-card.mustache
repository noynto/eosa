<a href="/products/{{productId}}" class="group">
    <div class="bg-bg-soft aspect-square rounded-3xl relative overflow-hidden">
        {{#hasImage}}
            <img src="/images/{{mainImageId}}"
                 alt="{{name}}"
                 class="w-full h-full object-cover">
        {{/hasImage}}
        {{^hasImage}}
            <svg viewBox="0 0 200 200" class="w-full h-full">
                <ellipse cx="100" cy="148" rx="52" ry="9" fill="#775546" opacity="0.15"/>
                <circle cx="100" cy="106" r="38" fill="#B8A88E" opacity="0.4"/>
            </svg>
        {{/hasImage}}
    </div>
    <div class="mt-3.5 px-1">
        <div class="flex justify-between items-baseline mb-1">
            <div class="font-serif text-[17px]">{{name}}</div>
            <div class="text-[15px] font-medium">{{price}} €</div>
        </div>
        {{#hasTagline}}
            <div class="text-xs text-secondary">{{tagline}}</div>
        {{/hasTagline}}
    </div>
</a>
