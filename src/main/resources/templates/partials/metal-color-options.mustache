{{#hasMetalColors}}
<div class="flex flex-col gap-2">
    <span class="text-xs text-secondary">Couleur du métal</span>
    <div class="flex flex-wrap gap-x-4 gap-y-3">
        {{#metalColors}}
        <label class="cursor-pointer flex flex-col items-center gap-1">
            <input type="radio" name="metalColorId" value="{{id}}" class="peer hidden" {{#selected}}checked{{/selected}}>
            <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-transparent peer-checked:border-primary bg-bg-soft">
                {{#hasImage}}<img src="/images/{{imageId}}" class="w-full h-full object-cover" alt="">{{/hasImage}}
            </div>
            <span class="text-xs text-secondary peer-checked:text-primary peer-checked:font-medium">{{name}}</span>
        </label>
        {{/metalColors}}
    </div>
</div>
{{/hasMetalColors}}
