<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    {{#noindex}}<meta name="robots" content="noindex, nofollow">{{/noindex}}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Eosa">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    <meta property="og:image" content="{{ogImageUrl}}">
    <meta property="og:url" content="{{canonicalUrl}}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="canonical" href="{{canonicalUrl}}">
    {{#jsonLd}}<script type="application/ld+json">{{{jsonLd}}}</script>{{/jsonLd}}
    <link rel="icon" type="image/jpeg" href="/favicon.jpg">
    <meta name="theme-color" content="#601414">
    <link rel="stylesheet" href="/fonts.css">
    <script src="/tailwind.min.js"></script>
    <script src="/htmx.min.js"></script>
    <script src="/tailwind.config.js"></script>
</head>
<body class="bg-bg font-sans text-primary antialiased">

<!-- Lien d'évitement : premier élément atteint au clavier, visible seulement quand il a le focus. -->
<a href="#contenu"
   class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 bg-bg text-primary border border-outline rounded-full px-5 min-h-11 inline-flex items-center text-sm font-medium">Aller au contenu</a>

<header class="border-b border-bg-border">
    <!-- La bannière de livraison est dans l'en-tête : tout le contenu de la page est ainsi dans un repère. -->
    <div hx-get="/shipping/banner" hx-trigger="load" hx-swap="outerHTML" class="bg-primary py-1.5">
        <div class="mx-auto w-48 h-3 rounded-full bg-primary-dark opacity-40 animate-pulse"></div>
    </div>
    <div class="grid grid-cols-[auto_1fr_auto] lg:grid-cols-[1fr_auto_1fr] items-center px-5 md:px-8 py-4 gap-4">
        <!-- Cinq liens : ils ne tiennent pas dans la colonne de gauche à 768 px, le menu de la tablette est donc
             celui du mobile (bouton « Menu ») ; la navigation en ligne commence à 1024 px. -->
        <nav aria-label="Navigation principale" class="hidden lg:flex gap-6 text-sm text-secondary">
            <a href="/jewels/necklaces" class="hover:text-primary transition-colors">Colliers</a>
            <a href="/jewels/bracelets" class="hover:text-primary transition-colors">Bracelets</a>
            <a href="/about" class="hover:text-primary transition-colors">Notre histoire</a>
            <a href="/workshops" class="hover:text-primary transition-colors">Ateliers</a>
            <a href="/gift-cards" class="hover:text-primary transition-colors">Carte cadeau</a>
        </nav>
        <!-- Un vrai bouton : atteignable au clavier, avec son état annoncé (aria-expanded). Le script est en bas de l'en-tête. -->
        <button type="button" id="mobile-menu-button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu"
                class="lg:hidden flex flex-col justify-center gap-1.5 cursor-pointer w-11 h-11 -ml-3 pl-3">
            <span class="w-5 h-px bg-primary block"></span>
            <span class="w-4 h-px bg-primary block"></span>
            <span class="w-5 h-px bg-primary block"></span>
        </button>
        <div class="text-center">
            <a href="/" class="font-display text-4xl text-primary leading-none inline-block py-1 -my-1">eosa.</a>
        </div>
        <div class="flex items-center gap-3 justify-end">
            <span class="hidden lg:block text-xs text-secondary">FR / €</span>
            <a href="/cart" class="bg-bg-soft text-primary px-4 min-h-11 rounded-full text-sm flex items-center gap-2 hover:bg-bg-border transition-colors">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                Panier
            </a>
        </div>
    </div>
    <nav id="mobile-menu" aria-label="Navigation principale" class="hidden lg:hidden flex-col border-t border-bg-border text-sm text-secondary">
        <a href="/jewels/necklaces" class="px-5 py-3.5 hover:text-primary hover:bg-bg-soft transition-colors">Colliers</a>
        <a href="/jewels/bracelets" class="px-5 py-3.5 hover:text-primary hover:bg-bg-soft transition-colors">Bracelets</a>
        <a href="/about" class="px-5 py-3.5 hover:text-primary hover:bg-bg-soft transition-colors">Notre histoire</a>
        <a href="/workshops" class="px-5 py-3.5 hover:text-primary hover:bg-bg-soft transition-colors">Ateliers</a>
        <a href="/gift-cards" class="px-5 py-3.5 hover:text-primary hover:bg-bg-soft transition-colors">Carte cadeau</a>
    </nav>
    <script>
        (function () {
            var button = document.getElementById('mobile-menu-button');
            var menu = document.getElementById('mobile-menu');
            function show(open) {
                button.setAttribute('aria-expanded', open ? 'true' : 'false');
                menu.classList.toggle('hidden', !open);
                menu.classList.toggle('flex', open);
            }
            button.addEventListener('click', function () {
                show(button.getAttribute('aria-expanded') !== 'true');
            });
            // Échap referme le menu et rend le focus au bouton.
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
                    show(false);
                    button.focus();
                }
            });
        })();
    </script>
</header>

<!-- Le contenu de la page ; fermé au début du pied de page (partials/footer-main). -->
<main id="contenu">
