{{> ../partials/header-admin}}

<div class="max-w-2xl">

    <div class="flex flex-wrap items-center gap-3 mb-8">
        <a href="/orders" class="text-xs text-muted hover:text-secondary transition-colors">← Commandes</a>
        <span class="text-muted">/</span>
        <h1 class="text-xl font-medium">{{number}}</h1>
        <span class="text-xs text-secondary border border-bg-border rounded-full px-2 py-0.5">{{state}}</span>
        {{#isHandDelivery}}<span class="text-xs text-secondary border border-bg-border rounded-full px-2 py-0.5">Remise en main propre</span>{{/isHandDelivery}}
        {{#overdue}}<span class="text-xs font-medium text-error border border-error rounded-full px-2 py-0.5">En retard</span>{{/overdue}}
    </div>

    <!-- Résumé -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
            <div class="text-xs text-muted mb-1">Payée le</div>
            <div class="text-sm font-medium">{{paidAt}}</div>
            {{#showCraftingDeadline}}
            <div class="text-xs text-secondary">À fabriquer avant le {{craftingDeadline}}</div>
            {{/showCraftingDeadline}}
        </div>
        <div>
            <div class="text-xs text-muted mb-1">Cliente</div>
            <div class="text-sm font-medium">{{customerName}}</div>
            <div class="text-xs text-secondary break-words">
                <a href="mailto:{{customerEmail}}" class="hover:underline underline-offset-4">{{customerEmail}}</a>
                {{#hasPhone}}<br><a href="tel:{{customerPhone}}" class="hover:underline underline-offset-4">{{customerPhone}}</a>{{/hasPhone}}
            </div>
        </div>
        <div>
            <div class="text-xs text-muted mb-1">Livraison</div>
            {{#hasAddress}}
            <div class="text-sm font-medium">{{addressName}}</div>
            <div class="text-xs text-secondary">
                {{addressLine1}}<br>
                {{#hasAddressLine2}}{{addressLine2}}<br>{{/hasAddressLine2}}
                {{addressPostalCode}} {{addressCity}}<br>
                {{addressCountry}}
            </div>
            {{/hasAddress}}
            {{^hasAddress}}
            <div class="text-xs text-secondary">Adresse effacée{{#hasPurgedAt}} le {{purgedAt}}{{/hasPurgedAt}}.</div>
            {{/hasAddress}}
        </div>
    </section>

    <!-- Fabrication : envoi par Mondial Relay (étiquette) ou remise en main propre -->
    {{#canCraft}}
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-1">Pièce fabriquée</h2>
        {{#canCraftForShipping}}
        <p class="text-xs text-muted mb-3">Envoi par Mondial Relay : crée l'étiquette et passe la commande à « Fabriquée ». Confirmez le poids du colis.</p>
        <form hx-post="/orders/{{id}}/craft" hx-target="#craft-error" hx-swap="innerHTML"
              class="flex flex-wrap items-end gap-3">
            <div class="flex flex-col gap-1.5">
                <label for="weight" class="text-xs text-secondary">Poids du colis</label>
                <div class="relative">
                    <input id="weight" name="weight" type="number" min="10" max="30000" step="1" required value="{{defaultWeight}}"
                           class="bg-bg-soft border border-outline rounded-lg pl-3 pr-10 py-2 text-sm text-primary focus:border-secondary w-36">
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-muted">g</span>
                </div>
            </div>
            <button type="submit" class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                Pièce fabriquée, à expédier
            </button>
        </form>
        {{/canCraftForShipping}}
        <div class="{{#canCraftForShipping}}mt-5 pt-5 border-t border-bg-border{{/canCraftForShipping}}">
            <p class="text-xs text-muted mb-3">Remise en main propre : aucune étiquette, aucun transporteur et aucun e-mail à la cliente (la remise se convient avec elle). Les frais de livraison déjà payés ne sont pas remboursés ici : le remboursement se fait dans Stripe, à la main.</p>
            <button hx-post="/orders/{{id}}/craft-hand-delivery" hx-target="#craft-error" hx-swap="innerHTML"
                    hx-confirm="Fabriquée pour une remise en main propre ? Aucune étiquette ne sera créée."
                    class="border border-outline px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm text-secondary hover:border-secondary hover:text-primary transition-colors">
                Pièce fabriquée, remise en main propre
            </button>
        </div>
        <span id="craft-error" class="text-xs block mt-3"></span>
    </section>
    {{/canCraft}}

    <!-- Remise en main propre : la pièce est fabriquée, reste à la remettre -->
    {{#canHandOver}}
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-1">Remise en main propre</h2>
        <p class="text-xs text-muted mb-3">Fabriquée le {{craftedHandAt}}. À faire quand la pièce est remise à la cliente : la commande passe à « Livrée », sans e-mail.</p>
        <button hx-post="/orders/{{id}}/hand-over" hx-target="#hand-over-error" hx-swap="innerHTML"
                hx-confirm="Confirmer que la pièce a été remise en main propre ?"
                class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
            Remise effectuée
        </button>
        <span id="hand-over-error" class="text-xs block mt-2"></span>
    </section>
    {{/canHandOver}}

    <!-- Étiquette -->
    {{#hasLabel}}
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-3">Étiquette d'expédition</h2>
        <dl class="text-sm flex flex-col gap-1">
            <div class="flex justify-between gap-4"><dt class="text-secondary">Transporteur</dt><dd>Mondial Relay</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-secondary">Numéro de suivi</dt><dd class="break-all text-right">{{trackingNumber}}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-secondary">Poids</dt><dd>{{labelWeight}} g</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-secondary">Fabriquée le</dt><dd>{{craftedAt}}</dd></div>
        </dl>
        {{#showShippingDeadline}}
        <p class="text-xs text-secondary mt-3">À expédier avant le {{shippingDeadline}}</p>
        {{/showShippingDeadline}}
        {{#canPrintLabel}}
        <a href="/orders/{{id}}/label" target="_blank" rel="noopener"
           class="mt-4 border border-outline px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm text-secondary hover:border-secondary hover:text-primary transition-colors">
            Imprimer l'étiquette
        </a>
        {{/canPrintLabel}}
    </section>
    {{/hasLabel}}

    <!-- Suite de la commande : remettre le colis, le déclarer livré -->
    {{#canShip}}
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-1">Colis remis</h2>
        <p class="text-xs text-muted mb-3">À faire quand le colis est déposé chez le transporteur. La commande passe à « Expédiée » et la cliente reçoit l'e-mail avec le lien de suivi.</p>
        <button hx-post="/orders/{{id}}/ship" hx-target="#ship-error" hx-swap="innerHTML"
                hx-confirm="Confirmer que le colis est remis au transporteur ? La cliente sera prévenue par e-mail."
                class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
            Colis remis
        </button>
        <span id="ship-error" class="text-xs block mt-2"></span>
    </section>
    {{/canShip}}
    {{#canDeliver}}
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-1">Livrée</h2>
        <p class="text-xs text-muted mb-3">À faire quand le colis est arrivé chez la cliente. Aucun e-mail n'est envoyé.</p>
        <button hx-post="/orders/{{id}}/deliver" hx-target="#deliver-error" hx-swap="innerHTML"
                hx-confirm="Confirmer que le colis est livré ?"
                class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
            Livrée
        </button>
        <span id="deliver-error" class="text-xs block mt-2"></span>
    </section>
    {{/canDeliver}}

    <!-- Dates de l'expédition, de la livraison et de l'annulation -->
    {{#hasSuite}}
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-3">Suite</h2>
        <dl class="text-sm flex flex-col gap-1">
            {{#hasShippedAt}}<div class="flex justify-between gap-4"><dt class="text-secondary">Expédiée le</dt><dd>{{shippedAt}}</dd></div>{{/hasShippedAt}}
            {{#hasDeliveredAt}}<div class="flex justify-between gap-4"><dt class="text-secondary">{{#isHandDelivery}}Remise en main propre le{{/isHandDelivery}}{{^isHandDelivery}}Livrée le{{/isHandDelivery}}</dt><dd>{{deliveredAt}}</dd></div>{{/hasDeliveredAt}}
        </dl>
    </section>
    {{/hasSuite}}
    {{#isCancelled}}
    <section class="bg-bg border border-error rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium text-error mb-3">Commande annulée</h2>
        <dl class="text-sm flex flex-col gap-1">
            <div class="flex justify-between gap-4"><dt class="text-secondary">Annulée le</dt><dd>{{cancelledAt}}</dd></div>
            <div><dt class="text-secondary">Motif</dt><dd class="break-words">{{cancelReason}}</dd></div>
        </dl>
        <p class="text-xs text-muted mt-3">Le remboursement se fait dans Stripe, à la main. La cliente n'a reçu aucun e-mail.</p>
    </section>
    {{/isCancelled}}

    <!-- Lignes -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-3">Pièces à fabriquer</h2>
        {{#items}}
        <div class="flex items-center gap-4 py-3 border-b border-bg-border last:border-0">
            {{#hasImage}}
            <img src="/images/{{imageId}}" alt="" width="56" height="56" loading="lazy"
                 class="w-14 h-14 rounded-lg object-cover bg-bg-soft shrink-0">
            {{/hasImage}}
            <div class="flex-1 min-w-0">
                <div class="text-sm font-medium">
                    {{#hasJewel}}<a href="/jewels/{{jewelId}}" class="hover:underline underline-offset-4">{{name}}</a>{{/hasJewel}}
                    {{^hasJewel}}{{name}}{{/hasJewel}}
                </div>
                <div class="text-xs text-secondary">{{quantity}} × {{unitPrice}}</div>
            </div>
            <div class="text-sm font-medium shrink-0">{{lineTotal}}</div>
        </div>
        {{/items}}
        <dl class="mt-3 text-sm flex flex-col gap-1">
            <div class="flex justify-between"><dt class="text-secondary">Articles</dt><dd>{{itemsAmount}}</dd></div>
            <div class="flex justify-between"><dt class="text-secondary">Livraison</dt><dd>{{shippingAmount}}</dd></div>
            <div class="flex justify-between font-medium"><dt>Total</dt><dd>{{totalAmount}}</dd></div>
        </dl>
    </section>

    <!-- Journal des e-mails -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-3">E-mails</h2>
        <dl class="text-sm flex flex-col gap-1">
            <div class="flex justify-between gap-4"><dt class="text-secondary">Confirmation à la cliente</dt><dd class="text-right">{{confirmationMail}}</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-secondary">Nouvelle commande à EOSA</dt><dd class="text-right">{{notificationMail}}</dd></div>
            {{#showShippingMail}}<div class="flex justify-between gap-4"><dt class="text-secondary">Expédition à la cliente</dt><dd class="text-right">{{shippingMail}}</dd></div>{{/showShippingMail}}
        </dl>
    </section>

    {{#canCancel}}
    <!-- Annulation -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <h2 class="text-sm font-medium mb-1">Annuler la commande</h2>
        <p class="text-xs text-muted mb-3">Aucun e-mail n'est envoyé à la cliente et rien n'est remboursé : le remboursement se fait dans Stripe, à la main. Une étiquette déjà créée reste chez le transporteur. Cette action est irréversible.</p>
        <form hx-post="/orders/{{id}}/cancel" hx-target="#cancel-error" hx-swap="innerHTML"
              hx-confirm="Annuler la commande {{number}} ? Cette action est irréversible."
              class="flex flex-col gap-3">
            <div class="flex flex-col gap-1.5">
                <label for="reason" class="text-xs text-secondary">Motif</label>
                <textarea id="reason" name="reason" rows="2" maxlength="500" required
                          class="bg-bg-soft border border-outline rounded-lg px-3 py-2 text-sm text-primary focus:border-secondary w-full"></textarea>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <button type="submit" class="border border-outline px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm text-secondary hover:border-error hover:text-error transition-colors">
                    Annuler la commande
                </button>
                <span id="cancel-error" class="text-xs"></span>
            </div>
        </form>
    </section>
    {{/canCancel}}

    <p class="text-xs text-muted break-all">Session Stripe : {{stripeSessionId}}</p>

</div>

{{> ../partials/footer-admin}}
