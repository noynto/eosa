{{> ../partials/header-admin}}

<div class="flex items-center justify-between gap-3 mb-6">
    <h1 class="text-xl font-medium">Sessions d'atelier</h1>
    <button onclick="document.getElementById('modal').classList.remove('hidden')"
            class="bg-primary text-accent px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors shrink-0">
        + Nouvelle session
    </button>
</div>

<h2 class="text-xs text-muted tracking-widest uppercase mb-3">À venir</h2>
<div class="bg-bg border border-bg-border rounded-xl overflow-hidden mb-8">
    {{#upcomingSessions}}
    <a href="/workshops/{{id}}"
       class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 px-4 py-3 border-b border-bg-border last:border-0 hover:bg-bg-soft transition-colors {{#cancelled}}opacity-60{{/cancelled}}">
        <div class="flex-1 min-w-0">
            <div class="text-sm font-medium">{{date}} · {{timeRange}}</div>
            <div class="text-xs text-secondary truncate">{{venueName}} — {{venueCity}}</div>
        </div>
        <div class="flex items-center justify-between sm:justify-end gap-4 shrink-0">
            <span class="text-xs text-secondary">{{status}}</span>
            <span class="text-sm font-medium w-14 text-right">{{occupiedPlaces}} / {{capacity}}</span>
        </div>
    </a>
    {{/upcomingSessions}}
    {{^hasUpcomingSessions}}
    <p class="px-4 py-8 text-sm text-muted text-center">Aucune session à venir.</p>
    {{/hasUpcomingSessions}}
</div>

{{#hasPastSessions}}
<h2 class="text-xs text-muted tracking-widest uppercase mb-3">Passées</h2>
<div class="bg-bg border border-bg-border rounded-xl overflow-hidden">
    {{#pastSessions}}
    <a href="/workshops/{{id}}"
       class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 px-4 py-3 border-b border-bg-border last:border-0 hover:bg-bg-soft transition-colors opacity-60">
        <div class="flex-1 min-w-0">
            <div class="text-sm">{{date}} · {{timeRange}}</div>
            <div class="text-xs text-secondary truncate">{{venueName}} — {{venueCity}}</div>
        </div>
        <div class="flex items-center justify-between sm:justify-end gap-4 shrink-0">
            <span class="text-xs text-secondary">{{status}}</span>
            <span class="text-sm w-14 text-right">{{occupiedPlaces}} / {{capacity}}</span>
        </div>
    </a>
    {{/pastSessions}}
</div>
{{/hasPastSessions}}

<!-- Modal création -->
<div id="modal" class="hidden fixed inset-0 bg-primary/30 backdrop-blur-sm flex items-center justify-center z-50 p-4"
     onclick="if(event.target===this){this.classList.add('hidden')}">
    <div class="bg-bg rounded-xl border border-bg-border p-6 w-full max-w-sm shadow-lg">
        <h2 class="text-sm font-medium mb-4">Nouvelle session</h2>
        {{#hasVenues}}
        <form hx-post="/workshops" hx-target="#create-error" hx-swap="innerHTML" class="flex flex-col gap-4">
            <div class="flex flex-col gap-1.5">
                <label for="venueId" class="text-xs text-secondary">Lieu</label>
                <select id="venueId" name="venueId" required
                        onchange="const o=this.selectedOptions[0]; this.form.capacity.value=o.dataset.capacity; this.form.durationMinutes.value=o.dataset.duration;"
                        class="bg-bg-soft border border-bg-border rounded-lg px-3 py-2 text-sm text-primary focus:outline-none focus:border-secondary">
                    {{#venues}}
                    <option value="{{id}}" data-capacity="{{defaultCapacity}}" data-duration="{{defaultDurationMinutes}}">{{name}} — {{city}}</option>
                    {{/venues}}
                </select>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="flex flex-col gap-1.5">
                    <label for="date" class="text-xs text-secondary">Date</label>
                    <input id="date" name="date" type="date" required
                           class="bg-bg-soft border border-bg-border rounded-lg px-3 py-2 text-sm text-primary focus:outline-none focus:border-secondary w-full">
                </div>
                <div class="flex flex-col gap-1.5">
                    <label for="time" class="text-xs text-secondary">Heure de début</label>
                    <input id="time" name="time" type="time" required step="300"
                           class="bg-bg-soft border border-bg-border rounded-lg px-3 py-2 text-sm text-primary focus:outline-none focus:border-secondary w-full">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="flex flex-col gap-1.5">
                    <label for="durationMinutes" class="text-xs text-secondary">Durée (min)</label>
                    <input id="durationMinutes" name="durationMinutes" type="number" min="15" max="480" step="15" required value="{{firstVenueDuration}}"
                           class="bg-bg-soft border border-bg-border rounded-lg px-3 py-2 text-sm text-primary focus:outline-none focus:border-secondary w-full">
                </div>
                <div class="flex flex-col gap-1.5">
                    <label for="capacity" class="text-xs text-secondary">Places</label>
                    <input id="capacity" name="capacity" type="number" min="1" max="50" step="1" required value="{{firstVenueCapacity}}"
                           class="bg-bg-soft border border-bg-border rounded-lg px-3 py-2 text-sm text-primary focus:outline-none focus:border-secondary w-full">
                </div>
            </div>
            <p class="text-xs text-muted">Durée et places sont pré-remplies avec les valeurs par défaut du lieu. Les réservations ouvriront 7 jours avant le début.</p>
            <span id="create-error"></span>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="document.getElementById('modal').classList.add('hidden')"
                        class="px-4 py-2 rounded-lg text-sm text-secondary hover:text-primary transition-colors">
                    Annuler
                </button>
                <button type="submit"
                        class="bg-primary text-accent px-5 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                    Créer
                </button>
            </div>
        </form>
        {{/hasVenues}}
        {{^hasVenues}}
        <p class="text-sm text-secondary mb-4">Il faut d'abord créer un lieu pour pouvoir y planifier une session.</p>
        <div class="flex justify-end">
            <a href="/workshop-venues" class="bg-primary text-accent px-5 py-2 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                Gérer les lieux
            </a>
        </div>
        {{/hasVenues}}
    </div>
</div>

{{> ../partials/footer-admin}}
