{{> ../partials/header-admin}}

<div class="flex items-center justify-between gap-3 mb-6">
    <h1 class="text-xl font-medium">Commandes</h1>
</div>

<form method="get" action="/orders" class="flex flex-col sm:flex-row gap-3 mb-4">
    <label for="state" class="sr-only">État</label>
    <select id="state" name="state" onchange="this.form.submit()"
            class="bg-bg border border-outline rounded-lg px-3 min-h-11 md:min-h-9 text-sm text-primary focus:border-secondary">
        {{#filters}}
        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/filters}}
    </select>
    <label for="q" class="sr-only">Rechercher</label>
    <input id="q" name="q" type="search" value="{{search}}" placeholder="Numéro, nom ou e-mail"
           class="flex-1 bg-bg border border-outline rounded-lg px-3 min-h-11 md:min-h-9 text-sm text-primary focus:border-secondary">
    <button type="submit"
            class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
        Rechercher
    </button>
</form>

<div class="bg-bg border border-bg-border rounded-xl overflow-hidden">
    {{#orders}}
    <a href="/orders/{{id}}"
       class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 px-4 py-3 border-b border-bg-border last:border-0 hover:bg-bg-soft transition-colors">
        <div class="flex-1 min-w-0">
            <div class="text-sm font-medium">{{number}}</div>
            <div class="text-xs text-secondary truncate">{{customer}} · {{paidAt}}</div>
        </div>
        <div class="flex items-center justify-between sm:justify-end gap-4 shrink-0">
            {{#overdue}}<span class="text-xs font-medium text-error">En retard</span>{{/overdue}}
            <span class="text-xs text-secondary">{{state}}</span>
            <span class="text-sm font-medium w-24 text-right">{{total}}</span>
        </div>
    </a>
    {{/orders}}
    {{^hasOrders}}
    <p class="px-4 py-8 text-sm text-muted text-center">Aucune commande.</p>
    {{/hasOrders}}
</div>

{{> ../partials/footer-admin}}
