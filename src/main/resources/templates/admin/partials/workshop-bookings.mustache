<!-- Inscrites -->
<section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 class="text-sm font-medium">Inscrites</h2>
        {{#hasBookingsToMark}}
        <button hx-post="/workshops/{{workshopSessionId}}/attended"
                hx-target="#toast-attended" hx-swap="innerHTML"
                hx-confirm="Marquer présentes toutes les inscrites pas encore pointées ?"
                class="bg-primary text-accent px-3 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
            Tout le monde présent
        </button>
        {{/hasBookingsToMark}}
    </div>
    <span id="toast-attended" class="text-xs"></span>
    {{#started}}
    <p class="text-xs text-muted mb-2">Absence possible à partir de {{noShowFrom}} (30 min de tolérance). Une adresse marquée absente ne peut plus réserver en ligne pendant un an ; « Présente » corrige une erreur.</p>
    {{/started}}
    {{#bookings}}
    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-3 border-b border-bg-border last:border-0">
        <div class="flex-1 min-w-0">
            <div class="text-sm font-medium">{{name}}</div>
            <div class="text-xs text-secondary truncate">
                <a href="mailto:{{email}}" class="hover:underline underline-offset-4">{{email}}</a>{{#hasPhone}} · <a href="tel:{{phone}}" class="hover:underline underline-offset-4">{{phone}}</a>{{/hasPhone}}
            </div>
        </div>
        <div class="flex items-center justify-between sm:flex-col sm:items-end gap-1 shrink-0">
            <span class="text-xs font-medium">{{state}}</span>
            <span class="text-xs text-muted">le {{bookedAt}}</span>
            {{#canCancel}}
            <button hx-post="/workshops/{{workshopSessionId}}/bookings/{{id}}/cancel"
                    hx-target="#toast-booking-{{id}}" hx-swap="innerHTML"
                    hx-confirm="Annuler la réservation de {{name}} ? Elle sera prévenue par e-mail."
                    class="text-xs text-secondary underline underline-offset-4 py-2 hover:text-error transition-colors">
                Annuler
            </button>
            <span id="toast-booking-{{id}}" class="text-xs"></span>
            {{/canCancel}}
            <div class="flex items-center gap-2">
                {{#canMarkAttended}}
                <button hx-post="/workshops/{{workshopSessionId}}/bookings/{{id}}/attended"
                        hx-target="#toast-mark-{{id}}" hx-swap="innerHTML"
                        class="border border-outline px-3 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-xs text-secondary hover:border-success hover:text-success transition-colors">
                    Présente
                </button>
                {{/canMarkAttended}}
                {{#canMarkNoShow}}
                {{#noShowAvailable}}
                <button hx-post="/workshops/{{workshopSessionId}}/bookings/{{id}}/no-show"
                        hx-target="#toast-mark-{{id}}" hx-swap="innerHTML"
                        hx-confirm="Marquer {{name}} absente ? Elle ne pourra plus réserver en ligne."
                        class="border border-outline px-3 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-xs text-secondary hover:border-error hover:text-error transition-colors">
                    Absente
                </button>
                {{/noShowAvailable}}
                {{^noShowAvailable}}
                <button disabled title="Possible à partir de {{noShowFrom}}"
                        class="border border-outline px-3 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-xs text-secondary opacity-40 cursor-not-allowed">
                    Absente dès {{noShowFrom}}
                </button>
                {{/noShowAvailable}}
                {{/canMarkNoShow}}
            </div>
            <span id="toast-mark-{{id}}" class="text-xs"></span>
        </div>
    </div>
    {{/bookings}}
    {{^hasBookingRows}}
    <p class="text-sm text-muted">Aucune inscrite pour l'instant.</p>
    {{/hasBookingRows}}
</section>
