{{#hasWaitlist}}
<!-- Liste d'attente -->
<section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
    <h2 class="text-sm font-medium mb-1">Liste d'attente</h2>
    <p class="text-xs text-muted mb-3">Toutes sont prévenues par e-mail à l'ouverture des réservations, puis dès qu'une place se libère ; les premières qui réservent obtiennent les places. Une personne déjà prévenue il y a moins de 6 h n'est pas prévenue de nouveau.</p>
    <div class="flex flex-wrap items-center gap-3 mb-3">
        <button hx-post="/workshops/{{workshopSessionId}}/waitlist/remind"
                hx-target="#toast-reminder" hx-swap="innerHTML"
                hx-confirm="Envoyer un e-mail « Il reste des places » aux personnes en attente ({{waitlistCount}} inscrites) ? Les personnes prévenues il y a moins de 6 h sont ignorées."
                class="border border-outline px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm text-secondary hover:border-secondary hover:text-primary transition-colors">
            Relancer la liste d'attente
        </button>
        <span id="toast-reminder" class="text-xs"></span>
    </div>
    {{#waitlist}}
    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-3 border-b border-bg-border last:border-0">
        <div class="flex-1 min-w-0">
            <div class="text-sm font-medium">{{firstName}}</div>
            <div class="text-xs text-secondary truncate"><a href="mailto:{{email}}" class="hover:underline underline-offset-4">{{email}}</a></div>
        </div>
        <div class="flex items-center justify-between sm:flex-col sm:items-end gap-1 shrink-0">
            <span class="text-xs">{{#notified}}Prévenue le {{notifiedAt}}{{/notified}}{{^notified}}En attente{{/notified}}</span>
            <span class="text-xs text-muted">depuis le {{joinedAt}}</span>
        </div>
    </div>
    {{/waitlist}}
</section>
{{/hasWaitlist}}
