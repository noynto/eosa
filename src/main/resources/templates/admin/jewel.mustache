{{> ../partials/header-admin}}

<div class="max-w-2xl">

    <div class="flex flex-wrap items-center justify-between gap-y-2 mb-8">
        <div class="flex items-center gap-3">
            <a href="/jewels" class="text-xs text-muted hover:text-secondary transition-colors">← Produits</a>
            <span class="text-muted">/</span>
            <h1 id="jewel-title" class="text-xl font-medium">{{name}}</h1>
        </div>
        <!-- La fiche publique est sur la boutique : sur ce serveur, /jewels/{id} est cette page d'administration. -->
        <a href="{{publicUrl}}/jewels/{{jewelId}}" target="_blank" rel="noopener"
           class="flex items-center gap-1.5 text-xs text-secondary hover:text-primary border border-bg-border rounded-lg px-3 py-1.5 transition-colors">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Voir la page
        </a>
    </div>

    <!-- Nom -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-medium"><label for="jewel-name">Nom</label></h2>
            <span id="toast-name" class="text-xs text-success"></span>
        </div>
        <form hx-patch="/jewels/{{jewelId}}/name"
              hx-target="#toast-name" hx-swap="innerHTML"
              class="flex items-center gap-3">
            <input id="jewel-name" name="name" type="text" required value="{{name}}" autocomplete="off"
                   class="bg-bg-soft border border-outline rounded-lg px-3 py-2 text-sm text-primary placeholder-muted focus:border-secondary w-full min-w-0">
            <button type="submit" class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                Enregistrer
            </button>
        </form>
    </section>

    <!-- Accroche -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-medium">Accroche</h2>
            <span id="toast-tagline" class="text-xs text-success"></span>
        </div>
        <form hx-patch="/jewels/{{jewelId}}/tagline"
              hx-target="#toast-tagline" hx-swap="innerHTML"
              class="flex flex-col gap-3">
            <textarea name="tagline" rows="3" placeholder="Une courte description du produit…"
                      class="bg-bg-soft border border-outline rounded-lg px-3 py-2 text-sm text-primary placeholder-muted focus:border-secondary resize-none w-full"
            >{{tagline}}</textarea>
            <div class="flex justify-end">
                <button type="submit" class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                    Enregistrer
                </button>
            </div>
        </form>
    </section>

    <!-- Prix -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-medium">Prix</h2>
            <span id="toast-price" class="text-xs text-success"></span>
        </div>
        <form hx-patch="/jewels/{{jewelId}}/price"
              hx-target="#toast-price" hx-swap="innerHTML"
              class="flex items-center gap-3">
            <div class="relative">
                <input name="price" type="number" min="0" step="0.01"
                       value="{{price}}"
                       placeholder="0.00"
                       class="bg-bg-soft border border-outline rounded-lg pl-3 pr-8 py-2 text-sm text-primary placeholder-muted focus:border-secondary w-36">
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-muted">€</span>
            </div>
            <button type="submit" class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                Enregistrer
            </button>
        </form>
    </section>

    <!-- Catégorie -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mb-4">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-medium">Catégorie</h2>
            <span id="toast-category" class="text-xs text-success"></span>
        </div>
        <form hx-patch="/jewels/{{jewelId}}/category"
              hx-target="#toast-category" hx-swap="innerHTML"
              class="flex items-center gap-3">
            <select name="category"
                    class="bg-bg-soft border border-outline rounded-lg px-3 py-2 text-sm text-primary focus:border-secondary">
                <option value="">— Aucune —</option>
                <option value="NECKLACE" {{#categoryNecklaceSelected}}selected{{/categoryNecklaceSelected}}>Collier</option>
                <option value="BRACELET" {{#categoryBraceletSelected}}selected{{/categoryBraceletSelected}}>Bracelet</option>
            </select>
            <button type="submit" class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                Enregistrer
            </button>
        </form>
    </section>

    <!-- Images -->
    {{> partials/jewel-images}}

    <!-- État -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mt-4">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-medium">État</h2>
            <span id="toast-state" class="text-xs text-success"></span>
        </div>
        <form hx-patch="/jewels/{{jewelId}}/state"
              hx-target="#toast-state" hx-swap="innerHTML"
              class="flex items-center gap-3">
            <select name="state"
                    class="bg-bg-soft border border-outline rounded-lg px-3 py-2 text-sm text-primary focus:border-secondary">
                <option value="DRAFTED" {{#stateDraftedSelected}}selected{{/stateDraftedSelected}}>Brouillon</option>
                <option value="PUBLISHED" {{#statePublishedSelected}}selected{{/statePublishedSelected}}>Publié</option>
                <option value="ARCHIVED" {{#stateArchivedSelected}}selected{{/stateArchivedSelected}}>Archivé</option>
            </select>
            <button type="submit" class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                Enregistrer
            </button>
        </form>
        {{^statePublishedSelected}}
        <p class="text-xs text-error mt-3">Ce bijou n'est pas publié : il n'apparaît pas dans la boutique.</p>
        {{/statePublishedSelected}}
    </section>

    {{#hasPublishedAt}}
    <!-- Date de publication -->
    <section class="bg-bg border border-bg-border rounded-xl p-5 mt-4">
        <div class="flex items-center justify-between mb-1">
            <h2 class="text-sm font-medium">Date de publication</h2>
            <span id="toast-published-at" class="text-xs text-success"></span>
        </div>
        <p class="text-xs text-muted mb-3">Elle ordonne les nouveautés et le catalogue : les bijoux les plus récemment publiés passent en premier. Posée à la première publication, elle se corrige ici.</p>
        <form hx-patch="/jewels/{{jewelId}}/published-at"
              hx-target="#toast-published-at" hx-swap="innerHTML"
              class="flex flex-wrap items-center gap-3">
            <input name="publishedOn" type="date" required value="{{publishedOn}}"
                   class="bg-bg-soft border border-outline rounded-lg px-3 py-2 text-sm text-primary focus:border-secondary">
            <button type="submit" class="bg-primary text-accent px-4 min-h-11 md:min-h-9 inline-flex items-center justify-center rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                Enregistrer
            </button>
        </form>
    </section>
    {{/hasPublishedAt}}

</div>

{{> ../partials/footer-admin}}
