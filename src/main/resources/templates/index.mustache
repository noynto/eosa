{{> partials/header-main}}

<!-- Hero -->
<section class="grid md:grid-cols-[1.2fr_1fr] border-b border-bg-border">
    <div class="bg-bg-soft relative overflow-hidden min-h-64 md:min-h-0 lg:min-h-hero border-b md:border-b-0 md:border-r border-bg-border">
        {{#hasHeroVideo}}
        <!-- Vidéo de la collection publiée la plus récente. Elle ne se charge ni ne se lance pour qui demande moins de
             mouvement ou économise ses données : l'affiche reste, et le bouton permet de la lancer. -->
        <video id="hero-video" muted loop playsinline preload="none" poster="/images/{{heroPosterId}}"
               aria-label="Collection {{heroCollectionName}}"
               class="w-full h-full object-cover lg:absolute lg:inset-0">
            <source src="/videos/{{heroVideoId}}" type="video/mp4">
        </video>
        <button id="hero-toggle" type="button" aria-label="Lire la vidéo"
                class="absolute bottom-3 right-3 w-11 h-11 rounded-full bg-bg/80 text-primary inline-flex items-center justify-center hover:bg-bg transition-colors">
            <svg id="hero-icon-play" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8z"/></svg>
            <svg id="hero-icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
        </button>
        <script>
            (function () {
                var video = document.getElementById('hero-video');
                var toggle = document.getElementById('hero-toggle');
                var play = document.getElementById('hero-icon-play');
                var pause = document.getElementById('hero-icon-pause');
                function show(playing) {
                    play.classList.toggle('hidden', playing);
                    pause.classList.toggle('hidden', !playing);
                    toggle.setAttribute('aria-label', playing ? 'Mettre la vidéo en pause' : 'Lire la vidéo');
                }
                var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches
                    || (navigator.connection && navigator.connection.saveData);
                show(false);
                if (!calm) {
                    video.preload = 'metadata';
                    video.play().catch(function () { show(false); });
                }
                video.addEventListener('play', function () { show(true); });
                video.addEventListener('pause', function () { show(false); });
                toggle.addEventListener('click', function () {
                    if (video.paused) { video.play(); } else { video.pause(); }
                });
            })();
        </script>
        {{/hasHeroVideo}}
        {{^hasHeroVideo}}
        <img src="/hero.webp" alt="Bijoux Eosa" class="w-full h-full object-cover lg:absolute lg:inset-0"/>
        {{/hasHeroVideo}}
    </div>
    <div class="px-8 md:px-12 py-12 md:py-16 flex flex-col justify-center">
        <p class="text-xs text-secondary tracking-widest mb-5">NOUVELLE COLLECTION</p>
        <h1 class="font-serif text-5xl md:text-6xl font-normal leading-[1.05] mb-6">
            Bijoux qui<br/>rayonnent.
        </h1>
        <p class="text-sm text-secondary leading-relaxed mb-8 max-w-xs">
            Colliers, bracelets et pierres, faits main à Nancy. Des pièces en matières nobles, conçues pour durer.
        </p>
        <div class="flex gap-3 flex-wrap">
            <a href="/jewels" class="bg-secondary text-bg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary transition-colors">Voir la collection</a>
            <a href="/about" class="border border-bg-border px-6 py-3 rounded-full text-sm text-secondary hover:border-secondary transition-colors">Notre histoire</a>
        </div>
    </div>
</section>

<!-- Nos univers -->
<section class="px-5 md:px-8 py-10">
    <div class="flex items-baseline gap-3 mb-6">
        <span class="font-serif text-xs text-muted">01</span>
        <h2 class="font-serif text-2xl font-normal">Nos univers</h2>
        <span class="text-xs text-secondary ml-1">explorer par famille</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/jewels/necklaces" class="border border-bg-border rounded-2xl p-5 flex items-center gap-5 hover:border-secondary transition-colors">
            <div class="w-14 h-14 flex-shrink-0">
                <svg viewBox="0 0 56 56" class="w-full h-full">
                    <path d="M8 18 Q28 50 48 18" stroke="#601414" stroke-width="1.5" fill="none" stroke-dasharray="2.5 2"/>
                    <circle cx="28" cy="44" r="6" stroke="#601414" stroke-width="1.5" fill="#F4EFE5"/>
                    <circle cx="28" cy="44" r="3" fill="#601414"/>
                </svg>
            </div>
            <div>
                <div class="font-serif text-xl leading-tight">Colliers</div>
                <div class="text-xs text-secondary mt-1">
                    {{necklacesCountLabel}}
                    {{#necklacesHasMinPrice}}
                        · dès {{necklacesMinPrice}} €
                    {{/necklacesHasMinPrice}}
                </div>
            </div>
        </a>
        <a href="/jewels/bracelets" class="border border-bg-border rounded-2xl p-5 flex items-center gap-5 hover:border-secondary transition-colors">
            <div class="w-14 h-14 flex-shrink-0">
                <svg viewBox="0 0 56 56" class="w-full h-full">
                    <ellipse cx="28" cy="28" rx="18" ry="10" stroke="#601414" stroke-width="1.5" fill="none" stroke-dasharray="2.5 2"/>
                    <circle cx="10" cy="28" r="3.5" stroke="#601414" stroke-width="1.5" fill="#F4EFE5"/>
                    <circle cx="28" cy="18" r="2.5" stroke="#601414" stroke-width="1.5" fill="#F4EFE5"/>
                    <circle cx="46" cy="28" r="3.5" stroke="#601414" stroke-width="1.5" fill="#F4EFE5"/>
                </svg>
            </div>
            <div>
                <div class="font-serif text-xl leading-tight">Bracelets</div>
                <div class="text-xs text-secondary mt-1">
                    {{braceletsCountLabel}}
                    {{#braceletsHasMinPrice}}
                        · dès {{braceletsMinPrice}} €
                    {{/braceletsHasMinPrice}}
                </div>
            </div>
        </a>
    </div>
</section>

<!-- Nouveautés -->
<section class="px-5 md:px-8 pb-12">
    <div class="flex items-baseline justify-between mb-6">
        <div class="flex items-baseline gap-3">
            <span class="font-serif text-xs text-muted">02</span>
            <h2 class="font-serif text-2xl font-normal">Nouveautés</h2>
            <span class="text-xs text-secondary ml-1">dernières arrivées</span>
        </div>
        <a href="/jewels" class="text-xs text-secondary hover:text-primary transition-colors">Tout voir →</a>
    </div>
    <div hx-get="/jewels/latest" hx-trigger="load" hx-swap="innerHTML"
         class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-5">
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
    </div>
</section>

<!-- Atelier editorial -->
<section class="grid md:grid-cols-2 border-t border-bg-border">
    <div class="px-8 md:px-12 py-12 md:py-16 flex flex-col justify-center order-2 md:order-1">
        <p class="text-xs text-secondary tracking-widest mb-3">L'ATELIER</p>
        <h2 class="font-serif text-4xl font-normal leading-tight mb-5">Faits main,<br/>montés à Nancy.</h2>
        <p class="text-sm text-secondary leading-relaxed mb-7 max-w-sm">
            Chaque bijou est pensé, dessiné et assemblé dans notre atelier. Des matières soigneusement sélectionnées, des pièces conçues pour traverser le temps.
        </p>
        <div class="flex gap-3 flex-wrap">
            <a href="/workshops" class="bg-secondary text-bg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary transition-colors">Participer à un atelier</a>
            <a href="/about" class="border border-bg-border px-6 py-3 rounded-full text-sm text-secondary hover:border-secondary transition-colors">En savoir plus</a>
        </div>
    </div>
    <div class="bg-bg-soft relative overflow-hidden min-h-64 lg:min-h-hero order-1 md:order-2 border-b md:border-b-0 md:border-l border-bg-border">
        <img src="/workshop.webp" alt="Atelier Eosa" class="w-full h-full object-cover lg:absolute lg:inset-0"/>
    </div>
</section>

