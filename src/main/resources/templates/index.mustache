{{> partials/header-main}}

<!-- Hero -->
<!-- Le hero tient environ 85 % de la hauteur visible. Le voile sombre derrière le texte garantit un contraste d'au
     moins 4,5:1 sur n'importe quelle image de la vidéo ; il s'efface vers le haut pour laisser voir la vidéo. -->
<section class="relative isolate overflow-hidden min-h-hero-screen flex items-end border-b border-bg-border bg-primary-dark">
    {{#hasHeroVideo}}
    <!-- Vidéo de la collection publiée la plus récente. Elle ne se charge ni ne se lance pour qui demande moins de
         mouvement ou économise ses données : l'affiche reste, et le bouton permet de la lancer. -->
    <video id="hero-video" muted loop playsinline preload="none" poster="/images/{{heroPosterId}}"
           aria-label="Collection {{heroCollectionName}}"
           class="absolute inset-0 w-full h-full object-cover -z-20">
        <source src="/videos/{{heroVideoId}}" type="video/mp4">
    </video>
    {{/hasHeroVideo}}
    {{^hasHeroVideo}}
    <img src="/hero.webp" alt="Bijoux Eosa" class="absolute inset-0 w-full h-full object-cover -z-20"/>
    {{/hasHeroVideo}}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-primary-dark/75 from-60% to-transparent" aria-hidden="true"></div>

    <!-- Même marge gauche que l'en-tête et les sections (px-5 md:px-8) : tout le texte de la page s'aligne. -->
    <div class="w-full px-5 md:px-8 pb-10 md:pb-16 pt-32">
        <p class="text-xs text-bg tracking-widest mb-4 uppercase">{{heroLabel}}</p>
        <h1 class="font-serif text-5xl md:text-7xl font-normal leading-[1.05] text-bg mb-5 max-w-2xl">
            {{#hasHeroHeadline}}{{heroHeadline}}{{/hasHeroHeadline}}{{^hasHeroHeadline}}Bijoux qui<br/>rayonnent.{{/hasHeroHeadline}}
        </h1>
        <p class="text-sm md:text-base text-bg leading-relaxed mb-8 max-w-md">
            {{#hasHeroBlurb}}{{heroBlurb}}{{/hasHeroBlurb}}{{^hasHeroBlurb}}Colliers, bracelets et pierres, faits main à Nancy. Des pièces en matières nobles, conçues pour durer.{{/hasHeroBlurb}}
        </p>
        <div class="flex gap-3 flex-wrap">
            <a href="/jewels" class="bg-bg text-primary px-6 py-3 rounded-full text-sm font-medium hover:bg-bg-soft transition-colors">Voir la collection</a>
            <a href="/about" class="border border-bg text-bg px-6 py-3 rounded-full text-sm hover:bg-bg/10 transition-colors">Notre histoire</a>
        </div>
    </div>

    {{#hasHeroVideo}}
    <button id="hero-toggle" type="button" aria-label="Lire la vidéo"
            class="absolute top-4 right-4 md:top-auto md:bottom-6 md:right-8 w-11 h-11 rounded-full bg-bg/80 text-primary inline-flex items-center justify-center hover:bg-bg transition-colors">
            <svg id="hero-icon-play" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4l14 8-14 8z"/></svg>
            <svg id="hero-icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
        </button>
        <script>
            (function () {
                var video = document.getElementById('hero-video');
                var toggle = document.getElementById('hero-toggle');
                var play = document.getElementById('hero-icon-play');
                var pause = document.getElementById('hero-icon-pause');
                function show(playing) {
                    play.classList.toggle('hidden', playing);
                    pause.classList.toggle('hidden', !playing);
                    toggle.setAttribute('aria-label', playing ? 'Mettre la vidéo en pause' : 'Lire la vidéo');
                }
                var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches
                    || (navigator.connection && navigator.connection.saveData);
                show(false);
                if (!calm) {
                    video.preload = 'metadata';
                    video.play().catch(function () { show(false); });
                }
                video.addEventListener('play', function () { show(true); });
                video.addEventListener('pause', function () { show(false); });
                toggle.addEventListener('click', function () {
                    if (video.paused) { video.play(); } else { video.pause(); }
                });
            })();
        </script>
    {{/hasHeroVideo}}
</section>

<!-- Nos univers -->
<section class="px-5 md:px-8 py-10">
    <div class="flex items-baseline gap-3 mb-6">
        <span class="font-serif text-xs text-muted">01</span>
        <h2 class="font-serif text-2xl font-normal">Nos univers</h2>
        <span class="text-xs text-secondary ml-1">explorer par famille</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/jewels/necklaces" class="border border-bg-border rounded-2xl p-5 flex items-center gap-5 hover:border-secondary transition-colors">
            <div class="w-14 h-14 flex-shrink-0">
                <svg viewBox="0 0 56 56" class="w-full h-full">
                    <path d="M8 18 Q28 50 48 18" class="stroke-primary" stroke-width="1.5" fill="none" stroke-dasharray="2.5 2"/>
                    <circle cx="28" cy="44" r="6" class="stroke-primary fill-bg-soft" stroke-width="1.5"/>
                    <circle cx="28" cy="44" r="3" class="fill-primary"/>
                </svg>
            </div>
            <div>
                <div class="font-serif text-xl leading-tight">Colliers</div>
                <div class="text-xs text-secondary mt-1">
                    {{necklacesCountLabel}}
                    {{#necklacesHasMinPrice}}
                        · dès {{necklacesMinPrice}} €
                    {{/necklacesHasMinPrice}}
                </div>
            </div>
        </a>
        <a href="/jewels/bracelets" class="border border-bg-border rounded-2xl p-5 flex items-center gap-5 hover:border-secondary transition-colors">
            <div class="w-14 h-14 flex-shrink-0">
                <svg viewBox="0 0 56 56" class="w-full h-full">
                    <ellipse cx="28" cy="28" rx="18" ry="10" class="stroke-primary" stroke-width="1.5" fill="none" stroke-dasharray="2.5 2"/>
                    <circle cx="10" cy="28" r="3.5" class="stroke-primary fill-bg-soft" stroke-width="1.5"/>
                    <circle cx="28" cy="18" r="2.5" class="stroke-primary fill-bg-soft" stroke-width="1.5"/>
                    <circle cx="46" cy="28" r="3.5" class="stroke-primary fill-bg-soft" stroke-width="1.5"/>
                </svg>
            </div>
            <div>
                <div class="font-serif text-xl leading-tight">Bracelets</div>
                <div class="text-xs text-secondary mt-1">
                    {{braceletsCountLabel}}
                    {{#braceletsHasMinPrice}}
                        · dès {{braceletsMinPrice}} €
                    {{/braceletsHasMinPrice}}
                </div>
            </div>
        </a>
    </div>
</section>

<!-- Nouveautés -->
<section class="px-5 md:px-8 pb-12">
    <div class="flex items-baseline justify-between mb-6">
        <div class="flex items-baseline gap-3">
            <span class="font-serif text-xs text-muted">02</span>
            <h2 class="font-serif text-2xl font-normal whitespace-nowrap">Nouveautés</h2>
            <span class="hidden sm:inline text-xs text-secondary ml-1">dernières arrivées</span>
        </div>
        <a href="/jewels" class="text-xs text-secondary hover:text-primary transition-colors inline-block py-3.5 -my-3.5 shrink-0 whitespace-nowrap">Tout voir →</a>
    </div>
    <div hx-get="/jewels/latest" hx-trigger="load" hx-swap="innerHTML"
         class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-5">
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
        <div class="bg-bg-soft aspect-square rounded-3xl animate-pulse"></div>
    </div>
</section>

<!-- Carte cadeau : texte sans montant ni durée, ils se règlent sur la page d'achat. -->
<!-- Même structure que « L'atelier » : une bande coupée en deux, la carte stylisée prend la place de la photo. -->
<section class="grid md:grid-cols-2 border-t border-bg-border">
    <div class="bg-bg-soft min-h-64 lg:min-h-hero flex items-center justify-center px-8 py-12 border-b md:border-b-0 md:border-r border-bg-border" aria-hidden="true">
        <div class="border border-bg-border rounded-2xl bg-bg px-8 py-10 flex flex-col items-center text-center w-full max-w-xs">
            <span class="font-display text-2xl text-primary mb-4">eosa.</span>
            <span class="text-xs text-secondary tracking-widest mb-2">CARTE CADEAU</span>
            <span class="font-serif text-4xl text-primary">à offrir</span>
        </div>
    </div>
    <div class="px-8 md:px-12 py-12 md:py-16 flex flex-col justify-center">
        <p class="text-xs text-secondary tracking-widest mb-3">UN CADEAU</p>
        <h2 class="font-serif text-4xl font-normal leading-tight mb-5">Offrez le choix.</h2>
        <p class="text-sm text-secondary leading-relaxed mb-7 max-w-sm">
            Un montant au choix, reçu par e-mail avec son code. La personne qui la reçoit compose ses bijoux dans la boutique, en une ou plusieurs fois.
        </p>
        <div class="flex gap-3 flex-wrap">
            <a href="/gift-cards" class="bg-secondary text-bg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary transition-colors">Offrir une carte cadeau</a>
        </div>
    </div>
</section>

<!-- Atelier editorial -->
<section class="grid md:grid-cols-2 border-t border-bg-border">
    <div class="px-8 md:px-12 py-12 md:py-16 flex flex-col justify-center order-2 md:order-1">
        <p class="text-xs text-secondary tracking-widest mb-3">L'ATELIER</p>
        <h2 class="font-serif text-4xl font-normal leading-tight mb-5">Faits main,<br/>montés à Nancy.</h2>
        <p class="text-sm text-secondary leading-relaxed mb-7 max-w-sm">
            Chaque bijou est pensé, dessiné et assemblé dans notre atelier. Des matières soigneusement sélectionnées, des pièces conçues pour traverser le temps.
        </p>
        <div class="flex gap-3 flex-wrap">
            <a href="/workshops" class="bg-secondary text-bg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary transition-colors">Participer à un atelier</a>
            <a href="/about" class="border border-bg-border px-6 py-3 rounded-full text-sm text-secondary hover:border-secondary transition-colors">En savoir plus</a>
        </div>
    </div>
    <div class="bg-bg-soft relative overflow-hidden min-h-64 lg:min-h-hero order-1 md:order-2 border-b md:border-b-0 md:border-l border-bg-border">
        <img src="/workshop.webp" alt="Atelier Eosa" class="w-full h-full object-cover lg:absolute lg:inset-0"/>
    </div>
</section>

<!-- Prochains ateliers : le fragment est vide, et la section absente, quand aucune session n'est programmée. -->
<div hx-get="/workshops/upcoming" hx-trigger="load" hx-swap="outerHTML"></div>

{{> partials/footer-main}}
