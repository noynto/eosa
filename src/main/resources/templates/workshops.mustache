{{> partials/header-main}}

<!-- Intro -->
<section class="grid md:grid-cols-[1fr_1.1fr] border-b border-bg-border">
    <div class="px-8 md:px-12 py-12 md:py-16 flex flex-col justify-center order-2 md:order-1">
        <p class="text-xs text-secondary tracking-widest mb-5">ATELIERS</p>
        <h1 class="font-serif text-5xl md:text-6xl font-normal leading-[1.05] mb-6">
            Créez votre<br/>propre bijou.
        </h1>
        <p class="text-sm text-secondary leading-relaxed max-w-sm mb-4">
            Lors de nos ateliers, chaque participante choisit ses pierres naturelles, sa breloque et crée
            son propre collier ou bracelet fait main, dans une ambiance chaleureuse et conviviale.
        </p>
        <p class="text-sm text-secondary leading-relaxed max-w-sm mb-8">
            Pas besoin d'expérience : je vous accompagne à chaque étape et je fixe le fermoir.
            Vous repartez avec une pièce unique, créée de vos propres mains. 🤍
        </p>
        <div class="flex gap-3 flex-wrap items-center">
            <a href="https://ig.me/m/eosa.bijoux" target="_blank" rel="noopener" class="bg-secondary text-bg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary transition-colors inline-flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>Réserver sur Instagram</a>
            <a href="https://www.tiktok.com/@eosa.bijoux" target="_blank" rel="noopener" class="border border-bg-border px-6 py-3 rounded-full text-sm text-secondary hover:border-secondary transition-colors inline-flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>Réserver sur TikTok</a>
        </div>
        <a href="#tarifs" class="mt-4 text-xs text-secondary underline underline-offset-4 hover:text-primary transition-colors self-start">Voir les tarifs</a>
    </div>
    <div class="bg-bg-soft relative overflow-hidden min-h-64 lg:min-h-[480px] order-1 md:order-2 border-b md:border-b-0 md:border-l border-bg-border">
        <img src="/workshops.webp" alt="La sélection de pierres naturelles et de perles proposée pendant l'atelier" class="w-full h-full object-cover lg:absolute lg:inset-0"/>
    </div>
</section>

<!-- Déroulé -->
<section class="px-5 md:px-8 py-12 md:py-16">
    <div class="max-w-5xl mx-auto">
        <div class="flex items-baseline gap-3 mb-6">
            <span class="font-serif text-xs text-muted">01</span>
            <h2 class="font-serif text-2xl font-normal">Comment ça se passe</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="border border-bg-border rounded-2xl p-5">
                <div class="font-serif text-xs text-muted mb-3">Étape 1</div>
                <div class="font-serif text-xl leading-tight mb-2">Vous choisissez</div>
                <p class="text-xs text-secondary leading-relaxed">Vos pierres et votre breloque, parmi notre sélection.</p>
            </div>
            <div class="border border-bg-border rounded-2xl p-5">
                <div class="font-serif text-xs text-muted mb-3">Étape 2</div>
                <div class="font-serif text-xl leading-tight mb-2">Vous créez</div>
                <p class="text-xs text-secondary leading-relaxed">Vous enfilez les perles, je m'occupe de la finition.</p>
            </div>
            <div class="border border-bg-border rounded-2xl p-5">
                <div class="font-serif text-xs text-muted mb-3">Ambiance</div>
                <div class="font-serif text-xl leading-tight mb-2">8 personnes max.</div>
                <p class="text-xs text-secondary leading-relaxed">Un petit groupe, pour une ambiance intime.</p>
            </div>
            <div class="border border-bg-border rounded-2xl p-5">
                <div class="font-serif text-xs text-muted mb-3">À la fin</div>
                <div class="font-serif text-xl leading-tight mb-2">Vous repartez avec</div>
                <p class="text-xs text-secondary leading-relaxed">Votre création, dans une pochette cadeau EOSA.</p>
            </div>
        </div>
    </div>
</section>

<!-- Citation -->
<section class="bg-bg-soft border-y border-bg-border px-5 md:px-8 py-14 md:py-20">
    <figure class="max-w-2xl mx-auto text-center">
        <blockquote class="font-serif text-3xl md:text-4xl font-normal leading-snug">
            « Un moment à partager, de nouvelles rencontres, et un bijou qui vous ressemble. »
        </blockquote>
    </figure>
</section>

<!-- Tarifs -->
<section id="tarifs" class="px-5 md:px-8 py-12 md:py-16 scroll-mt-8">
    <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline gap-3 mb-6">
            <span class="font-serif text-xs text-muted">02</span>
            <h2 class="font-serif text-2xl font-normal">Tarifs</h2>
            <span class="text-xs text-secondary ml-1">par participante</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="border border-bg-border rounded-2xl p-6 flex items-baseline justify-between gap-4">
                <div>
                    <div class="font-serif text-2xl leading-tight">Collier</div>
                    <div class="text-xs text-secondary mt-1">personnalisé</div>
                </div>
                <div class="font-serif text-4xl">33 €</div>
            </div>
            <div class="border border-bg-border rounded-2xl p-6 flex items-baseline justify-between gap-4">
                <div>
                    <div class="font-serif text-2xl leading-tight">Bracelet</div>
                    <div class="text-xs text-secondary mt-1">personnalisé</div>
                </div>
                <div class="font-serif text-4xl">23 €</div>
            </div>
        </div>

        <div class="mt-10 text-center flex flex-col items-center">
            <p class="text-sm text-secondary leading-relaxed mb-6 max-w-md">
                Pour réserver, ou organiser un atelier entre amies, envoyez-nous un message privé sur
                Instagram ou TikTok (<span class="text-primary">@eosa.bijoux</span>) : nous vous
                communiquons les prochaines dates.
            </p>
            <div class="flex gap-3 flex-wrap justify-center">
                <a href="https://ig.me/m/eosa.bijoux" target="_blank" rel="noopener" class="bg-secondary text-bg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary transition-colors inline-flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>Réserver sur Instagram</a>
                <a href="https://www.tiktok.com/@eosa.bijoux" target="_blank" rel="noopener" class="border border-bg-border px-6 py-3 rounded-full text-sm text-secondary hover:border-secondary transition-colors inline-flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>Réserver sur TikTok</a>
            </div>
        </div>
    </div>
</section>

