{{> partials/header.html.mustache}}
                <tr>
                    <td style="padding:0 32px 8px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;letter-spacing:0.16em;text-transform:uppercase;color:#775546;">
                        Atelier EOSA
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 16px 32px;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:30px;line-height:34px;font-weight:400;color:#601414;">
                        Confirmez votre place
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 20px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#3D0A0A;">
                        Bonjour {{firstName}}, merci pour votre demande ! Votre place est retenue pendant
                        {{confirmationDelayMinutes}} minutes : confirmez-la en cliquant sur le bouton ci-dessous.
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 24px 32px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" bgcolor="#F4EFE5" width="100%" style="border-radius:16px;border-collapse:separate;">
                            <tr>
                                <td style="padding:20px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#3D0A0A;">
                                    <span style="font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:20px;line-height:26px;color:#601414;">{{venueName}}</span><br>
                                    {{date}} · {{timeRange}}<br>
                                    <a href="{{mapUrl}}" style="color:#775546;text-decoration:underline;">{{venueAddress}}</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 24px 32px;">
                        <table role="presentation" cellpadding="0" cellspacing="0">
                            <tr>
                                <td bgcolor="#775546" style="border-radius:24px;mso-padding-alt:14px 28px;">
                                    <a href="{{confirmUrl}}" style="display:inline-block;padding:14px 28px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:500;color:#FDFBF7;text-decoration:none;">Confirmer ma place</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 28px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#775546;">
                        Sans confirmation dans les {{confirmationDelayMinutes}} minutes, la place est libérée pour une autre participante.
                        Vous n'êtes pas à l'origine de cette demande ? Ignorez simplement cet e-mail.
                    </td>
                </tr>
{{> partials/footer.html.mustache}}
