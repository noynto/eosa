{{> partials/header.html.mustache}}
                <tr>
                    <td style="padding:0 32px 8px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;letter-spacing:0.16em;text-transform:uppercase;color:#775546;">
                        Commande
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 16px 32px;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:30px;line-height:34px;font-weight:400;color:#601414;">
                        Nouvelle commande {{number}}
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 20px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#3D0A0A;">
                        {{pieces}} pièce(s) à fabriquer pour {{totalAmount}}, commandée(s) par {{customerName}}
                        (<a href="mailto:{{customerEmail}}" style="color:#601414;text-decoration:underline;">{{customerEmail}}</a>).
                        {{#hasDiscount}}<br>Code de promotion {{promoCode}} : {{discountAmount}} de remise.{{/hasDiscount}}
                        {{#hasGiftCard}}<br>Carte cadeau : {{giftCardAmount}} (le total est ce que la cliente a réglé par carte bancaire).{{/hasGiftCard}}
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 24px 32px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" bgcolor="#F4EFE5" width="100%" style="border-radius:16px;border-collapse:separate;">
                            {{#items}}
                            <tr>
                                <td style="padding:12px 20px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#3D0A0A;">
                                    {{quantity}} × {{name}}
                                </td>
                            </tr>
                            {{/items}}
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 24px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#3D0A0A;">
                        À fabriquer avant le {{craftingDeadline}}.
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 28px 32px;">
                        <table role="presentation" cellpadding="0" cellspacing="0">
                            <tr>
                                <td bgcolor="#775546" style="border-radius:24px;mso-padding-alt:14px 28px;">
                                    <a href="{{orderUrl}}" style="display:inline-block;padding:14px 28px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:500;color:#FDFBF7;text-decoration:none;">Voir la commande</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
{{> partials/footer.html.mustache}}
