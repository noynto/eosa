{{> partials/header.html.mustache}}
                <tr>
                    <td style="padding:0 32px 16px 32px;font-family:Georgia,'Times New Roman',serif;font-size:24px;line-height:30px;color:#601414;">
                        Une place s'est libérée !
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 20px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:24px;color:#3D0A0A;">
                        Bonjour {{firstName}}, bonne nouvelle : une place vient de se libérer pour l'atelier que vous attendiez.
                        Toute la liste d'attente est prévenue en même temps, et la première personne qui réserve l'obtient.
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 20px 32px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" bgcolor="#F4EFE5" width="100%">
                            <tr>
                                <td style="padding:16px 20px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:22px;color:#3D0A0A;">
                                    <span style="font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:26px;color:#601414;">Chez {{venueName}}</span><br>
                                    {{date}} · {{timeRange}}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 20px 32px;">
                        <table role="presentation" cellpadding="0" cellspacing="0">
                            <tr>
                                <td bgcolor="#601414" style="padding:14px 28px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;">
                                    <a href="{{sessionUrl}}" style="color:#FFEFAE;text-decoration:none;">Réserver ma place</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:0 32px 32px 32px;font-family:'DM Sans',Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#775546;">
                        Vous ne souhaitez plus être prévenue pour cet atelier ?
                        <a href="{{leaveUrl}}" style="color:#601414;">Quitter la liste d'attente</a>.
                    </td>
                </tr>
{{> partials/footer.html.mustache}}
