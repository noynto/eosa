{{> partials/header-main}}

<nav class="px-5 md:px-8 py-3.5 text-xs text-muted border-b border-bg-border">
    <a href="/" class="hover:text-secondary transition-colors">Boutique</a><span class="mx-1.5">›</span><a href="/jewels" class="hover:text-secondary transition-colors">Bijoux</a><span class="mx-1.5">›</span><span class="text-primary">{{name}}</span>
</nav>

<section class="px-5 md:px-8 pt-6 pb-12 grid md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-10">

    <div class="min-w-0 flex flex-col-reverse md:flex-row gap-3.5">
        <div class="flex md:flex-col gap-2.5 overflow-x-auto md:overflow-visible">
            {{^hasImages}}
                <div class="w-16 h-16 bg-bg-soft rounded-xl border-2 border-primary relative overflow-hidden flex-shrink-0">
                    <svg viewBox="0 0 64 64" class="w-full h-full">
                        <circle cx="32" cy="32" r="20" fill="#B8A88E" opacity="0.4"/>
                    </svg>
                </div>
            {{/hasImages}}
            {{#images}}
                <div class="{{thumbClass}}"
                     onclick="document.getElementById('main-image').src='/images/{{id}}'">
                    <img src="/images/{{id}}" class="w-full h-full object-cover" alt="{{name}}">
                </div>
            {{/images}}
        </div>

        <div class="flex-1 bg-bg-soft aspect-square rounded-3xl relative overflow-hidden">
            {{#hasImages}}
                <img id="main-image" src="/images/{{mainImageId}}" class="w-full h-full object-cover cursor-zoom-in" alt="{{name}}">
            {{/hasImages}}
            {{^hasImages}}
                <svg viewBox="0 0 400 400" class="w-full h-full">
                    <ellipse cx="200" cy="280" rx="120" ry="16" fill="#775546" opacity="0.2"/>
                    <circle cx="200" cy="180" r="80" fill="#B8A88E" opacity="0.3"/>
                </svg>
            {{/hasImages}}
            {{#hasImages}}
            <!-- Agrandit l'image affichée ; sans photo, il n'y a rien à agrandir. -->
            <button type="button" id="zoom-open" aria-haspopup="dialog"
                    class="absolute bottom-4 right-4 bg-bg px-3.5 min-h-11 rounded-full text-xs text-primary inline-flex items-center gap-1.5 hover:bg-bg-soft transition-colors">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#601414" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M11 8v6M8 11h6"/></svg>
                Zoom
            </button>
            {{/hasImages}}
        </div>
    </div>

    <div class="flex flex-col gap-6 pt-2">
        <div>
            <h1 class="font-serif text-4xl font-normal leading-tight mb-1.5">{{name}}</h1>
            <div class="text-sm text-secondary mb-3.5">{{tagline}}</div>
            <div class="flex items-baseline gap-3">
                <span class="font-serif text-3xl">{{price}} €</span>

            </div>
        </div>

        <form hx-post="/cart/items/{{jewelId}}" hx-swap="none" class="flex flex-col gap-4">
            <!-- Les options sont les mêmes pour tous les bijoux : elles se chargent à part, dans le formulaire. -->
            <div hx-get="/customization/metal-colors" hx-trigger="load" hx-swap="outerHTML" class="flex flex-col gap-2">
                <div class="w-28 h-3 rounded-full bg-bg-soft animate-pulse"></div>
                <div class="flex gap-2.5">
                    <div class="w-10 h-10 rounded-full bg-bg-soft animate-pulse"></div>
                    <div class="w-10 h-10 rounded-full bg-bg-soft animate-pulse"></div>
                    <div class="w-10 h-10 rounded-full bg-bg-soft animate-pulse"></div>
                </div>
            </div>
            <div hx-get="/customization/charms" hx-trigger="load" hx-swap="outerHTML" class="flex flex-col gap-2">
                <div class="w-36 h-3 rounded-full bg-bg-soft animate-pulse"></div>
                <div class="flex gap-2">
                    <div class="w-28 h-8 rounded-full bg-bg-soft animate-pulse"></div>
                    <div class="w-24 h-8 rounded-full bg-bg-soft animate-pulse"></div>
                </div>
            </div>
            <button type="submit" class="w-full bg-primary text-accent py-4 rounded-full text-sm font-medium hover:bg-primary-dark transition-colors">Ajouter au panier — {{price}} €</button>
        </form>

        <div class="bg-bg-soft px-5 py-4 rounded-2xl flex flex-col gap-2.5 text-sm text-secondary">
            <div hx-get="/shipping/info" hx-trigger="load" hx-swap="outerHTML" class="flex items-center gap-2.5">
                <div class="w-4 h-4 rounded bg-bg-border animate-pulse flex-shrink-0"></div>
                <div class="w-56 h-3 rounded-full bg-bg-border animate-pulse"></div>
            </div>
            <div class="flex items-center gap-2.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#601414" stroke-width="2"><path d="M20 12V8H4v10h16v-3"/><path d="M16 11h6"/><path d="m19 8-3 3 3 3"/></svg>
                Retours gratuits sous 14 jours
            </div>
            <div class="flex items-center gap-2.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#601414" stroke-width="2"><path d="M12 2 9 9l-7 1 5 5-1 7 6-3 6 3-1-7 5-5-7-1Z"/></svg>
                Fait main dans notre atelier à Nancy
            </div>
        </div>
    </div>

</section>

{{#hasImages}}
<!-- Image agrandie : fenêtre native, qui se ferme avec Échap, par le bouton ou en cliquant dessus, et rend le focus au bouton « Zoom ». -->
<dialog id="zoom-dialog" aria-label="{{name}}, image agrandie"
        class="m-0 p-0 border-0 w-full h-full max-w-none max-h-none bg-primary-dark/95">
    <img id="zoom-image" src="" alt="{{name}}" class="w-full h-full object-contain p-4 md:p-8 cursor-zoom-out">
    <button type="button" aria-label="Fermer l'image agrandie"
            class="absolute top-4 right-4 w-11 h-11 rounded-full bg-bg/80 text-primary inline-flex items-center justify-center hover:bg-bg transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
</dialog>
<script>
    (function () {
        var dialog = document.getElementById('zoom-dialog');
        var image = document.getElementById('zoom-image');
        var main = document.getElementById('main-image');
        function open() {
            // L'image affichée au moment du clic : elle change quand on choisit une vignette.
            image.src = main.src;
            dialog.showModal();
        }
        document.getElementById('zoom-open').addEventListener('click', open);
        main.addEventListener('click', open);
        dialog.addEventListener('click', function () { dialog.close(); });
    })();
</script>
{{/hasImages}}

<section class="px-5 md:px-8 py-10 border-t border-bg-border">
    <h2 class="font-serif text-2xl font-normal mb-5">Détails</h2>
    <div class="grid md:grid-cols-2">
        <div class="py-3.5 border-b border-bg-border md:pr-6 flex justify-between"><span class="text-sm text-secondary">Matière</span><span class="text-sm">Perles et pierres non précieuses</span></div>
        <div class="py-3.5 border-b border-bg-border md:pl-6 flex justify-between"><span class="text-sm text-secondary">Fil</span><span class="text-sm">Câble tressé, gaine nylon</span></div>
        <div class="py-3.5 border-b border-bg-border md:pr-6 flex justify-between"><span class="text-sm text-secondary">Métal</span><span class="text-sm">Acier inoxydable</span></div>
        <div class="py-3.5 border-b border-bg-border md:pl-6 flex justify-between"><span class="text-sm text-secondary">Fermoir</span><span class="text-sm">Acier inoxydable</span></div>
        <div class="py-3.5 md:border-b-0 md:pr-6 flex justify-between"><span class="text-sm text-secondary">Entretien</span><span class="text-sm">Eau claire, séchage doux</span></div>
    </div>
</section>

<div hx-get="/jewels/{{jewelId}}/related" hx-trigger="load" hx-swap="outerHTML"></div>

{{> partials/footer-main}}
