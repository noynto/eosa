# Base URL (used for Stripe success/cancel redirects and image URLs)
EOSA_BASE_URL=http://localhost:8080

# PostgreSQL
EOSA_JDBC_URL=jdbc:postgresql://localhost:5432/eosa
EOSA_JDBC_USERNAME=user
EOSA_JDBC_PASSWORD=password

# MongoDB — legacy, only required when running EOSA_MIGRATE_MONGO_TO_POSTGRES_TASK
# Format: mongodb://[user]:[password]@[host]:[port]/[database]?authSource=admin
EOSA_MONGO_URL=mongodb://user:password@localhost:27017/eosa?authSource=admin

# Administrator credentials (HTTP Basic Auth)
EOSA_ADMIN_NAME=admin
EOSA_ADMIN_SECRET=change_me

# Stripe
EOSA_CLIENT_STRIPE_SECRET_KEY=sk_test_...

# Shipping
# Amount charged for shipping (e.g. 4.90)
EOSA_SHIPPING_AMOUNT=4.90
# Cart total above which shipping is free (e.g. 60.00)
EOSA_SHIPPING_FREE_THRESHOLD=60.00