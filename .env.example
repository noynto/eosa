# ──────────────────────────────────────────────────────────────────────────────
# Eosa — environment variables
#
# Copy to .env and adjust:  cp .env.example .env
#   - docker run --env-file .env ...  → every variable below is passed to the app
#   - docker compose                  → optional; overrides the defaults of compose.yaml
#                                        (EOSA_JDBC_URL is ignored, compose targets its
#                                        own postgres service)
#
# [required] the application refuses to start without it
# [optional] has a default, shown in the commented-out line
# Full reference: docs/ops/deployment.md
# ──────────────────────────────────────────────────────────────────────────────


# ── Public storefront ─────────────────────────────────────────────────────────

# [required] Public base URL of the storefront, without trailing slash.
# Used for Stripe success/cancel redirects, canonical and Open Graph URLs,
# the sitemap, and the admin "Voir le site" link.
EOSA_PUBLIC_BASE_URL=http://localhost:8080

# [optional] Port the storefront listens on.
# EOSA_PUBLIC_SERVER_PORT=8080


# ── Administration ────────────────────────────────────────────────────────────
# Runs on a separate server: keep its port off the public network
# (bind it to 127.0.0.1, or reach it with kubectl port-forward).

# [required] Base URL of the administration server, without trailing slash.
# Use https in production (e.g. https://admin.eosa.me): the session cookie is then
# sent over HTTPS only (Secure flag), which the installable admin PWA also requires.
EOSA_ADMIN_BASE_URL=http://localhost:18080

# [optional] Port the administration listens on.
# EOSA_ADMIN_SERVER_PORT=18080

# [required] Credentials of the default administrator identity, used to sign in
# on /sign-in. The identity is created by the one-shot task below.
EOSA_ADMIN_NAME=admin
# Use a strong random value in production (e.g. `openssl rand -base64 32`).
EOSA_ADMIN_SECRET=change_me

# [optional] When "true", creates the default administrator identity (if it does
# not exist yet) and exits instead of starting the servers. Meant for one-shot
# init jobs (Kubernetes initContainer, compose "create-admin" service), not for
# the long-running application.
# EOSA_CREATE_DEFAULT_ADMINISTRATOR_IDENTITY_TASK=false


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# The schema is created/migrated automatically by Flyway on startup.

# [required] JDBC URL: jdbc:postgresql://<host>:<port>/<database>
EOSA_JDBC_URL=jdbc:postgresql://localhost:5432/eosa
# [required] Database credentials. With docker compose they also create the
# database user, but only on the first start: changing them later requires
# resetting the volume (docker compose down -v).
EOSA_JDBC_USERNAME=user
EOSA_JDBC_PASSWORD=password


# ── Stripe ────────────────────────────────────────────────────────────────────

# [required] Stripe secret API key: sk_test_... in test mode, sk_live_... in production.
EOSA_CLIENT_STRIPE_SECRET_KEY=sk_test_...


# ── Shipping ──────────────────────────────────────────────────────────────────

# [required] Shipping fee added to the cart, in euros.
EOSA_SHIPPING_AMOUNT=4.90
# [required] Cart total (in euros) from which shipping is free.
EOSA_SHIPPING_FREE_THRESHOLD=60.00

# ── Shipping label: parcel and sender ─────────────────────────────────────────
# Printed on the label created when an order is marked as crafted.

# [optional] Parcel weight (grams) proposed when an order is marked as crafted.
# EOSA_SHIPPING_DEFAULT_PARCEL_WEIGHT_GRAMS=150
# [optional] Shipping box size in centimetres, required by Mondial Relay and the
# same for every order (no jewel has dimensions in the model).
# EOSA_SHIPPING_PARCEL_LENGTH_CM=12
# EOSA_SHIPPING_PARCEL_WIDTH_CM=9
# EOSA_SHIPPING_PARCEL_DEPTH_CM=4
# [optional at startup] Sender address. Without it, "Pièce fabriquée" fails with a
# clear message in the administration.
# EOSA_SHIPPING_SENDER_NAME=EOSA
# EOSA_SHIPPING_SENDER_LINE1=1 rue Exemple
# EOSA_SHIPPING_SENDER_POSTAL_CODE=54000
# EOSA_SHIPPING_SENDER_CITY=Nancy
# EOSA_SHIPPING_SENDER_PHONE=+33600000000
# EOSA_SHIPPING_SENDER_EMAIL=contact@eosa.me


# ── Mondial Relay V2 (create the label) ───────────────────────────────────────
# API Connect V2.0, used by "Pièce fabriquée". Optional at startup: without these
# values, "Pièce fabriquée" fails with a clear message in the administration.
# Credentials: Connect > "Configuration des API" > API Version V2.0.

# [optional] API address; the sandbox by default (labels are not real). Production:
# https://connect-api.mondialrelay.com/api/shipment
# EOSA_CLIENT_MONDIAL_RELAY_V2_API_URL=https://connect-api-sandbox.mondialrelay.com/api/shipment
# EOSA_CLIENT_MONDIAL_RELAY_V2_LOGIN=CODE@business-api.mondialrelay.com
# EOSA_CLIENT_MONDIAL_RELAY_V2_PASSWORD=change_me
# EOSA_CLIENT_MONDIAL_RELAY_V2_CUSTOMER_ID=BDTEST


# ── Mondial Relay V1 (track the parcel) ───────────────────────────────────────
# SOAP web service, used to read the status of a parcel (automatic tracking, not
# wired yet). Optional at startup.
# Credentials: Connect > "Configuration des API" > API Version V1.0.

# [optional] API address, the same for sandbox and production.
# EOSA_CLIENT_MONDIAL_RELAY_V1_API_URL=https://api.mondialrelay.com/WebService.asmx
# EOSA_CLIENT_MONDIAL_RELAY_V1_ENSEIGNE=BDTEST13
# EOSA_CLIENT_MONDIAL_RELAY_V1_PRIVATE_KEY=change_me


# ── E-mails (SMTP) ────────────────────────────────────────────────────────────
# Local: docker compose sends everything to Mailpit (http://localhost:8025)
# unless these are set. Production: Infomaniak SMTP with contact@eosa.me.

# [required] SMTP server host (mail.infomaniak.com in production).
EOSA_SMTP_HOST=mail.infomaniak.com
# [optional] SMTP port: 465 with ssl, 587 with starttls, 1025 for Mailpit.
# EOSA_SMTP_PORT=465
# [optional] ssl, starttls, or none (Mailpit only, never in production).
# EOSA_SMTP_SECURITY=ssl
# [optional] SMTP credentials; leave both unset for a server without
# authentication (Mailpit). Use an app password if 2FA is enabled on the mailbox.
EOSA_SMTP_USERNAME=contact@eosa.me
EOSA_SMTP_PASSWORD=change_me
# [optional] Sender address of every e-mail (shown as "EOSA").
# EOSA_MAIL_FROM=contact@eosa.me

# [optional] When set, sends a test e-mail to this address and exits instead of
# starting the servers. Locally: docker compose run --rm send-test-email
# EOSA_SEND_TEST_EMAIL_TO=you@example.com
