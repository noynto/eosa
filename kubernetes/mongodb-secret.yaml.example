# PLACEHOLDER — do not commit real values
# Replace with a SOPS-encrypted file or a SealedSecret before deploying to production
apiVersion: v1
kind: Secret
metadata:
  name: mongodb-secrets
type: Opaque
stringData:
  username: "change_me"
  password: "change_me"
  # Dedicated app user — used by eosa to connect (readWrite on eosa db only)
  # mongo-url in eosa-secrets must use these credentials
  app-username: "change_me"
  app-password: "change_me"