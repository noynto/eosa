# PLACEHOLDER — do not commit real values
# Replace with a SOPS-encrypted file or a SealedSecret before deploying to production
apiVersion: v1
kind: Secret
metadata:
  name: eosa-secrets
type: Opaque
stringData:
  # username/password must match the values in postgres-secrets
  jdbc-url: "jdbc:postgresql://postgres:5432/eosa"
  jdbc-username: "change_me"
  jdbc-password: "change_me"
  admin-name: "change_me"
  admin-secret: "change_me"
  stripe-secret-key: "secret"