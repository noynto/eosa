# PLACEHOLDER — do not commit real values
# Replace with a SOPS-encrypted file or a SealedSecret before deploying to production
apiVersion: v1
kind: Secret
metadata:
  name: eosa-secrets
type: Opaque
stringData:
  # username/password must match the values in postgres-secrets
  jdbc-url: "jdbc:postgresql://postgres:5432/eosa"
  jdbc-username: "change_me"
  jdbc-password: "change_me"
  admin-name: "change_me"
  admin-secret: "change_me"
  stripe-secret-key: "secret"
  # Infomaniak mailbox; use an app password if 2FA is enabled
  smtp-username: "contact@eosa.me"
  smtp-password: "change_me"
  # Mondial Relay V2 (création de l'étiquette ; « Configuration des API », API Version V2.0 dans Connect)
  mondial-relay-v2-login: "CODE@business-api.mondialrelay.com"
  mondial-relay-v2-password: "change_me"