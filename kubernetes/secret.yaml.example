# PLACEHOLDER — do not commit real values
# Replace with a SOPS-encrypted file or a SealedSecret before deploying to production
apiVersion: v1
kind: Secret
metadata:
  name: eosa-secrets
type: Opaque
stringData:
  # app-username:app-password must match the values in mongodb-secrets
  mongo-url: "mongodb://change_me:change_me@mongodb:27017/eosa?authSource=eosa"
  admin-name: "change_me"
  admin-secret: "change_me"
  stripe-secret-key: "secret"